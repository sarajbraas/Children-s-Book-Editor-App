      }
    },
    {
      "id": "tt-035",
      "text": "He waves over Kevin. He whistles to Nate. He whispers to Nettie to stand by the gate.",
      "emotion": "Excited/Energetic",
      "intensity": "high",
      "volume": "soft",
      "scene_refs": [
