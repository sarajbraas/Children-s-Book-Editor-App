  "chunks": [
    {
      "id": "tt-001",
      "text": "Terrible Tom is a riot at school. A prankster. A jokester. A jester. \"So cool!\"",
      "emotion": "Playful/Silly",
      "intensity": "medium",
      "volume": "normal",
      "humor_type": "mischief_defiance",
      "note": "quoted \"So cool!\" is voiced by admiring classmates, not Tom or the narrator",
      "illustration_inference": {
        "implied_scene": "the other kids think he's cool",
        "source": "author",
        "visual_energy": "medium"
      },
      "verse": {
        "syllables_per_line": [
          10,
          11
        ],
        "meter_break": false,
        "rhyme_role": "self_contained_couplet"
      }
    },
    {
      "id": "tt-002",
      "text": "They want him to sit. They want him to learn.",
      "emotion": "Neutral/Narrator",
      "intensity": "low",
      "volume": "normal",
      "verse": {
        "syllables_per_line": [
          10
        ],
        "meter_break": false,
        "rhyme_role": "opens_couplet",
        "rhymes_with_chunk": "tt-004"
      }
    },
    {
      "id": "tt-003",
      "text": "But instead....",
      "emotion": "Humorous/Funny",
      "intensity": "low",
      "volume": "soft",
      "humor_type": "surprise_reversal",
      "note": "comedic ellipsis pause -- the joke is completed by the illustration, not more text",
      "illustration_inference": {
        "implied_scene": "a full page of examples of him distracting the other students and wreaking havoc in class",
        "source": "author",
        "visual_energy": "high"
      },
      "verse": {
        "syllables_per_line": [
          3
        ],
        "meter_break": true,
        "rhyme_role": "interruption_between_rhyme"
      }
    },
    {
      "id": "tt-004",
      "text": "He gets glares from his teachers - quite stern.",
      "emotion": "Humorous/Funny",
      "intensity": "low",
      "volume": "normal",
      "humor_type": "dry_ironic",
      "verse": {
        "syllables_per_line": [
          9
        ],
        "meter_break": false,
        "rhyme_role": "closes_couplet",
        "rhymes_with_chunk": "tt-002"
      }
    },
    {
      "id": "tt-005",
      "text": "They ask him to read, and his skin starts to itch.",
      "emotion": "Humorous/Funny",
      "intensity": "medium",
      "volume": "normal",
      "humor_type": "exaggeration_hyperbole",
      "verse": {
        "syllables_per_line": [
          11
        ],
        "meter_break": false,
        "rhyme_role": "opens_couplet",
        "rhymes_with_chunk": "tt-006"
      }
    },
    {
      "id": "tt-006",
      "text": "He daydreams and doodles. \"School's just not my niche.\"",
      "emotion": "Playful/Silly",
      "intensity": "medium",
      "volume": "normal",
      "secondary_emotion": "Humorous/Funny",
      "humor_type": "wordplay_verbal_wit",
      "note": "quoted line is Tom's own dismissive quip",
      "verse": {
        "syllables_per_line": [
          12
        ],
        "meter_break": false,
        "rhyme_role": "closes_couplet",
        "rhymes_with_chunk": "tt-005"
      }
    },
    {
      "id": "tt-007",
      "text": "So Tom must disrupt it, from when the bell dings.",
      "emotion": "Playful/Silly",
      "intensity": "medium",
      "volume": "normal",
      "verse": {
        "syllables_per_line": [
          11
        ],
        "meter_break": false,
        "rhyme_role": "opens_couplet",
        "rhymes_with_chunk": "tt-008"
      }
    },
    {
      "id": "tt-008",
      "text": "He taunts kids in Math class. In Reading he sings. In Music he tickles. He whistles in Art.",
      "emotion": "Playful/Silly",
      "intensity": "high",
      "volume": "loud",
      "humor_type": "mischief_defiance",
      "verse": {
        "syllables_per_line": [
          11,
          10
        ],
        "meter_break": false,
        "rhyme_role": "closes_couplet_then_opens_new",
        "note": "first line ('sings') closes the couplet opened by tt-007 ('dings'); second line ('Art') opens a new couplet closed by tt-010 ('fart') across the tt-009 interruption"
      }
    },
    {
      "id": "tt-009",
      "text": "And just when it's quiet, he slips out...",
      "emotion": "Mysterious/Suspenseful",
      "intensity": "low",
      "volume": "whisper",
      "humor_type": "surprise_reversal",
      "note": "comic hush before the punchline",
      "verse": {
        "syllables_per_line": [
          10
        ],
        "meter_break": true,
        "rhyme_role": "interruption_between_rhyme"
      }
    },
    {
      "id": "tt-010",
      "text": "A fart...",
      "emotion": "Humorous/Funny",
      "intensity": "medium",
      "volume": "soft",
      "type": "sound_effect",
      "speaker": "Tom",
      "humor_type": "bodily_scatological",
      "note": "punchline of the previous line's setup pause; comic timing beat before and after",
      "verse": {
        "syllables_per_line": [
          2
        ],
        "meter_break": false,
        "rhyme_role": "closes_couplet",
        "rhymes_with_chunk": "tt-008"
      }
    },
    {
      "id": "tt-011",
      "text": "He hides near the lunchroom when he needs a rest.",
      "emotion": "Calm/Soothing",
      "intensity": "low",
      "volume": "soft",
      "verse": {
        "syllables_per_line": [
          11
        ],
        "meter_break": false,
        "rhyme_role": "opens_couplet",
        "rhymes_with_chunk": "tt-012"
      }
    },
    {
      "id": "tt-012",
      "text": "He sneaks in a snack to his favorite nest.",
      "emotion": "Playful/Silly",
      "intensity": "medium",
      "volume": "normal",
      "humor_type": "mischief_defiance",
      "scene_refs": [
        {
          "scene_id": "toms-nook-motif",
          "role": "setup"
        }
      ],
      "illustration_inference": {
        "implied_scene": "a nook where he hides his graphic novels",
        "source": "author",
        "visual_energy": "medium"
      },
      "verse": {
        "syllables_per_line": [
          11
        ],
        "meter_break": false,
        "rhyme_role": "closes_couplet",
        "rhymes_with_chunk": "tt-011"
      }
    },
    {
      "id": "tt-013",
      "text": "But back out at recess, the prankster prevails. When no one is looking, he lures in the tails.",
      "emotion": "Playful/Silly",
      "intensity": "medium",
      "volume": "normal",
      "humor_type": "mischief_defiance",
      "scene_refs": [
        {
          "scene_id": "turkey-invasion-arc",
          "role": "setup"
        }
      ],
      "illustration_inference": {
        "implied_scene": "Tom lays out something from his lunch for a rafter of turkeys lingering near the school",
        "source": "author",
        "visual_energy": "medium"
      },
      "verse": {
        "syllables_per_line": [
          11,
          11
        ],
        "meter_break": false,
        "rhyme_role": "self_contained_couplet"
      }
    },
    {
      "id": "tt-014",
      "text": "They shake their caruncles. They waggle their wattles. Their snoods flop around when they increase their throttles.",
      "emotion": "Playful/Silly",
      "intensity": "medium",
      "volume": "normal",
      "humor_type": "wordplay_verbal_wit",
      "note": "fun/unusual turkey-anatomy vocabulary carries the comic energy here",
      "verse": {
        "syllables_per_line": [
          12,
          12
        ],
        "meter_break": false,
        "rhyme_role": "self_contained_couplet"
      }
    },
    {
      "id": "tt-015",
      "text": "And Tom can't stop laughing. \"That wattle! That chin!\"",
      "emotion": "Humorous/Funny",
      "intensity": "medium",
      "volume": "normal",
      "humor_type": "incongruity_absurd",
      "note": "quoted exclamation is Tom's own delighted laughter",
      "verse": {
        "syllables_per_line": [
          12
        ],
        "meter_break": false,
        "rhyme_role": "opens_couplet",
        "rhymes_with_chunk": "tt-016"
      }
    },
    {
      "id": "tt-016",
      "text": "That full flock of turkeys is forceful. They're in!",
      "emotion": "Excited/Energetic",
      "intensity": "high",
      "volume": "loud",
      "scene_refs": [
        {
          "scene_id": "turkey-invasion-arc",
          "role": "inciting_incident"
        }
      ],
      "verse": {
        "syllables_per_line": [
          12
        ],
        "meter_break": false,
        "rhyme_role": "closes_couplet",
        "rhymes_with_chunk": "tt-015"
      }
    },
    {
      "id": "tt-017",
      "text": "They run in a blur. There's a head; there's a neck. They fly and they cruise and they jump and they peck.",
      "emotion": "Excited/Energetic",
      "intensity": "high",
      "volume": "loud",
      "humor_type": "slapstick_physical",
      "verse": {
        "syllables_per_line": [
          13,
          11
        ],
        "meter_break": false,
        "rhyme_role": "self_contained_couplet"
      }
    },
    {
      "id": "tt-018",
      "text": "They knock over trash cans. They gobble at Frannie. They trample the bookshelves. Their speed is uncanny.",
      "emotion": "Excited/Energetic",
      "intensity": "high",
      "volume": "loud",
      "humor_type": "slapstick_physical",
      "verse": {
        "syllables_per_line": [
          12,
          12
        ],
        "meter_break": false,
        "rhyme_role": "self_contained_couplet"
      }
    },
    {
      "id": "tt-019",
      "text": "Tom takes in the scene with a satisfied grin at the chaos he started when he let them in.",
      "emotion": "Humorous/Funny",
      "intensity": "medium",
      "volume": "normal",
      "humor_type": "mischief_defiance",
      "note": "Tom is still enjoying the chaos here -- the tone turns right after this",
      "verse": {
        "syllables_per_line": [
          11,
          12
        ],
        "meter_break": false,
        "rhyme_role": "self_contained_couplet"
      }
    },
    {
      "id": "tt-020",
      "text": "But...",
      "emotion": "Mysterious/Suspenseful",
      "intensity": "low",
      "volume": "soft",
      "humor_type": "surprise_reversal",
      "note": "turning point -- the chaos is about to stop being fun and start threatening things Tom actually cares about",
      "verse": {
        "syllables_per_line": [
          1
        ],
        "meter_break": true,
        "rhyme_role": "standalone_interruption"
      }
    },
    {
      "id": "tt-021",
      "text": "The turkeys blast by him and eat one kid's lunch. They gulp up the pie and the farm-fresh corn crunch.",
      "emotion": "Excited/Energetic",
      "intensity": "high",
      "volume": "loud",
      "secondary_emotion": "Nervous/Worried",
      "verse": {
        "syllables_per_line": [
          12,
          11
        ],
        "meter_break": false,
        "rhyme_role": "self_contained_couplet"
      }
    },
    {
      "id": "tt-022",
      "text": "They gobble up all of the tot casseroles. They even invade little kids' cubbyholes.",
      "emotion": "Excited/Energetic",
      "intensity": "high",
      "volume": "loud",
      "secondary_emotion": "Nervous/Worried",
      "verse": {
        "syllables_per_line": [
          12,
          12
        ],
        "meter_break": false,
        "rhyme_role": "self_contained_couplet"
      }
    },
    {
      "id": "tt-023",
      "text": "Tom's art room is trampled. The paint tubes are splat. And music is dead 'cause the drums are now flat.",
      "emotion": "Sad/Melancholic",
      "intensity": "high",
      "volume": "normal",
      "secondary_emotion": "Nervous/Worried",
      "note": "the chaos now hits things Tom and classmates actually care about",
      "verse": {
        "syllables_per_line": [
          11,
          11
        ],
        "meter_break": false,
        "rhyme_role": "self_contained_couplet"
      }
    },
    {
      "id": "tt-024",
      "text": "The math tests are crumpled. They can't read the scores. A science experiment's blown off the doors.",
      "emotion": "Nervous/Worried",
      "intensity": "high",
      "volume": "normal",
      "verse": {
        "syllables_per_line": [
          12,
          12
        ],
        "meter_break": false,
        "rhyme_role": "self_contained_couplet"
      }
    },
    {
      "id": "tt-025",
      "text": "Then just at that moment, like pulled by a hook, the turkeys bob right into Tom's favorite nook.",
      "emotion": "Nervous/Worried",
      "intensity": "high",
      "volume": "normal",
      "secondary_emotion": "Sad/Melancholic",
      "scene_refs": [
        {
          "scene_id": "toms-nook-motif",
          "role": "payoff"
        },
        {
          "scene_id": "turkey-invasion-arc",
          "role": "climax"
        }
      ],
      "note": "personal-stakes moment -- Tom's own safe space is threatened; this is what finally motivates him to act",
      "verse": {
        "syllables_per_line": [
          11,
          13
        ],
        "meter_break": false,
        "rhyme_role": "self_contained_couplet"
      }
    },
    {
      "id": "tt-026",
      "text": "Tom's eyes bulge out wide. \"Help! Hurry! Zoom-zoom!\"",
      "emotion": "Fearful/Scared",
      "intensity": "high",
      "volume": "shout",
      "secondary_emotion": "Excited/Energetic",
      "note": "Tom's own panicked shout",
      "verse": {
        "syllables_per_line": [
          11
        ],
        "meter_break": false,
        "rhyme_role": "opens_couplet",
        "rhymes_with_chunk": "tt-027"
      }
    },
    {
      "id": "tt-027",
      "text": "He must stop the chaos inside his classroom.",
      "emotion": "Nervous/Worried",
      "intensity": "high",
      "volume": "normal",
      "verse": {
        "syllables_per_line": [
          11
        ],
        "meter_break": false,
        "rhyme_role": "closes_couplet",
        "rhymes_with_chunk": "tt-026"
      }
    },
    {
      "id": "tt-028",
      "text": "Tom cannot control them. He raises his fists. The kids try to stop them by linking their wrists.",
      "emotion": "Nervous/Worried",
      "intensity": "high",
      "volume": "loud",
      "secondary_emotion": "Angry/Frustrated",
      "verse": {
        "syllables_per_line": [
          11,
          11
        ],
        "meter_break": false,
        "rhyme_role": "self_contained_couplet"
      }
    },
    {
      "id": "tt-029",
      "text": "Sounds bounce 'round the classroom - a gobbledy-roar!",
      "emotion": "Excited/Energetic",
      "intensity": "high",
      "volume": "loud",
      "verse": {
        "syllables_per_line": [
          11
        ],
        "meter_break": false,
        "rhyme_role": "opens_couplet",
        "rhymes_with_chunk": "tt-031"
      }
    },
    {
      "id": "tt-030",
      "text": "The turkeys take over.",
      "emotion": "Nervous/Worried",
      "intensity": "high",
      "volume": "normal",
      "verse": {
        "syllables_per_line": [
          6
        ],
        "meter_break": true,
        "rhyme_role": "interruption_between_rhyme"
      }
    },
    {
      "id": "tt-031",
      "text": "\"It's our school no more!\"",
      "emotion": "Fearful/Scared",
      "intensity": "high",
      "volume": "loud",
      "secondary_emotion": "Sad/Melancholic",
      "note": "quoted line spoken by a teacher or kid, per the illustration note",
      "illustration_inference": {
        "implied_scene": "teachers and kids are hiding and crying; one of them says this line",
        "source": "author",
        "visual_energy": "high"
      },
      "verse": {
        "syllables_per_line": [
          7
        ],
        "meter_break": false,
        "rhyme_role": "closes_couplet",
        "rhymes_with_chunk": "tt-029"
      }
    },
    {
      "id": "tt-032",
      "text": "The rafter of turkeys fluffs snoods and their chests. The kids must go up against their greatest test.",
      "emotion": "Nervous/Worried",
      "intensity": "high",
      "volume": "normal",
      "verse": {
        "syllables_per_line": [
          11,
          11
        ],
        "meter_break": false,
        "rhyme_role": "self_contained_couplet"
      }
    },
    {
      "id": "tt-033",
      "text": "Gobble gobble gobble gobble gobble!!!!!",
      "emotion": "Excited/Energetic",
      "intensity": "high",
      "volume": "shout",
      "type": "sound_effect",
      "speaker": "Turkeys",
      "scene_refs": [
