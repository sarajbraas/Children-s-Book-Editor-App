      }
    },
    {
      "id": "tt-034",
      "text": "Tom points to Annette, and to Juan, Eleanor. He motions to them to prop open the door.",
      "emotion": "Excited/Energetic",
      "intensity": "high",
      "volume": "soft",
      "scene_refs": [
        {
          "scene_id": "tactical-hush-motif",
